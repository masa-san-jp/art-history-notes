{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/art-history-notes/agent-task.schema.json",
  "title": "art-history-notes agent-task contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objective", "deliverables", "scope", "non_goals", "checks", "permissions", "limits", "risk", "completion"],
  "properties": {
    "version": {"const": 1},
    "objective": {"type": "string", "minLength": 1},
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "expected"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "default": [], "items": {"type": "string", "minLength": 1}}
      }
    },
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "default": [], "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "timeout_seconds"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "external_write"],
      "properties": {
        "network": {"enum": ["none", "read", "write"]},
        "external_write": {"type": "boolean"},
        "allowed_env": {"type": "array", "default": [], "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_minutes", "max_attempts", "max_output_bytes"],
      "properties": {
        "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 104857600}
      }
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "completion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
