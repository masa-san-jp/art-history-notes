{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/art-history-notes/agent-task.schema.json",
  "title": "art-history-notes external agent-task contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objective", "context", "scope", "requirements", "acceptance", "checks", "constraints", "depends_on", "non_goals"],
  "properties": {
    "version": {"const": 2},
    "objective": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read"],
      "properties": {"read": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "criterion": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "external_writes"],
      "properties": {
        "network": {"enum": ["forbidden", "read-only", "allowed"]},
        "external_writes": {"enum": ["forbidden", "explicit-only"]}
      }
    },
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
